# ============================================================================
# БОЧКА: Упакуй друга (v2.5) — Конфигурация окружения (.env)
# Скопируйте в .env и заполните ключи Supabase для коротких ссылок ?b=jakaqgx,
# хранения сжатых фото (512x512 WebP <= 60 КБ) + голосовых (WebM/Opus <= 40 КБ)
# и серверной охоты за билетами try_win_ticket(user_id).
# ============================================================================

# 1. Supabase (таблица public.barrels + Storage bucket barrel-portraits + RPC try_win_ticket)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_BUCKET=barrel-portraits

# 2. Telegram Mini App & Bot API
VITE_TG_BOT_TOKEN=
VITE_TG_BOT_USERNAME=bochka_quest_bot
VITE_TG_APP_NAME=app
VITE_TG_NOTIFY_WEBHOOK=

# 3. Публичный URL и чистые промо-ссылки релиза «Бочка» (в кино с 17 декабря)
VITE_PUBLIC_URL=https://bochka.quest
VITE_KINOPOISK_URL=https://www.kinopoisk.ru/film/11226275/
VITE_KINOPOISK_TRAILER_URL=https://www.kinopoisk.ru/film/11226275/video/210300/
VITE_TRAILER_MP4=./video/trailer.mp4
VITE_YOUTUBE_FALLBACK_ID=vAJpT_82uUo

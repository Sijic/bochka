# ============================================================================
# БОЧКА: Упакуй друга — Конфигурация окружения (.env)
# Скопируйте этот файл в .env и заполните ключи перед продакшн-деплоем.
# БЕЗ ключей прототип автоматически работает в автономном fallback-режиме
# (localStorage + компактные base64url-параметры ссылки ?b=...).
# ============================================================================

# 1. Supabase (таблица public.barrels + Storage bucket barrel-portraits)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_BUCKET=barrel-portraits

# 2. Telegram Mini App & Bot API (уведомления отправителю о вскрытии бочки)
# Для продакшна рекомендуется проксировать отправку через Edge Function (VITE_TG_NOTIFY_WEBHOOK),
# а для закрытого прототипа / MVP поддерживается прямой вызов с VITE_TG_BOT_TOKEN.
VITE_TG_BOT_TOKEN=
VITE_TG_BOT_USERNAME=bochka_quest_bot
VITE_TG_APP_NAME=app
VITE_TG_NOTIFY_WEBHOOK=

# 3. Публичный URL и промо-ссылки релиза «Бочка» (в кино с 17 декабря)
VITE_PUBLIC_URL=https://bochka.quest
VITE_KINOPOISK_URL=https://www.kinopoisk.ru/film/11226275/?socialAlias=MzcwNjU0MjQ%3D
VITE_TICKETS_URL=https://www.kinopoisk.ru/film/11226275/?socialAlias=MzcwNjU0MjQ%3D
VITE_YOUTUBE_ID=EZFDcXeLTzQ

# ============================================================================
# БОЧКА: Достучаться до небес (v4.0 Production) — Шаблон .env
# ВНИМАНИЕ: Секретные ключи (TELEGRAM_BOT_TOKEN, SUPABASE_SERVICE_ROLE_KEY)
# хранятся СТРОГО в Supabase Secrets и локальном .env (НЕ в VITE_* переменных!).
# ============================================================================

# 1. Публичные параметры клиента (безопасны под RLS)
VITE_SUPABASE_URL=https://cevcmsypwohmpethybzf.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_BUCKET=barrel-media
VITE_SUPABASE_PASSES_BUCKET=cinema-passes

# 2. Telegram Mini App & Webhook
VITE_TG_BOT_USERNAME=bochka_film_bot
VITE_TG_APP_NAME=play
VITE_TG_NOTIFY_WEBHOOK=https://cevcmsypwohmpethybzf.supabase.co/functions/v1/tg-webhook

# 3. Промо-ссылки фильма «Бочка» (в кино с 17 декабря)
VITE_PUBLIC_URL=https://bochka.quest
VITE_KINOPOISK_URL=https://www.kinopoisk.ru/film/11226275/
VITE_KINOPOISK_TRAILER_URL=https://www.kinopoisk.ru/film/11226275/video/210300/
VITE_TRAILER_MP4=./video/trailer.mp4
VITE_YOUTUBE_FALLBACK_ID=vAJpT_82uUo

# 4. Серверные секреты (ТОЛЬКО для CLI / Edge Functions, не попадают в браузер!)
SUPABASE_PROJECT_REF=cevcmsypwohmpethybzf
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
ADMIN_TG_CHAT_ID=
